# TubeForge configuration — copy to .env and edit.
# All keys from LLD §11. Secrets live ONLY in .env (never flags).

# Optional YouTube Data API v3 key. Empty = RSS/oEmbed only.
YOUTUBE_API_KEY=

# Database file (single-file SQLite-format .db, WAL journal mode).
TUBEFORGE_DB_PATH=~/.tubeforge/tubeforge.db

# Data root: index/, backups/ live here.
TUBEFORGE_DATA_DIR=~/.tubeforge/

# Snapshot location for `backup` (VACUUM INTO).
TUBEFORGE_BACKUP_DIR=~/.tubeforge/backups

# Pinned Chromium install dir for `thumbnail render` (auto-downloaded on
# first use by chromiumoxide_fetcher; reused on later renders).
TUBEFORGE_CHROMIUM_DIR=~/.tubeforge/chromium

# Retention: keep last N snapshots, prune older.
TUBEFORGE_BACKUP_KEEP=10

# SEO/GEO composite weights (Phase 2 scoring).
TUBEFORGE_WEIGHTS_SEO=1.0
TUBEFORGE_WEIGHTS_GEO=1.0
# Per-component overrides (defaults baked; sums are normalized at use time).
# TUBEFORGE_SEO_KEYWORD_TITLE=0.30
# TUBEFORGE_SEO_TITLE_FRONT=0.10
# TUBEFORGE_SEO_TITLE_LENGTH=0.10
# TUBEFORGE_SEO_TITLE_HOOKS=0.05
# TUBEFORGE_SEO_KEYWORD_DESC=0.15
# TUBEFORGE_SEO_DESC_FIRST150=0.10
# TUBEFORGE_SEO_DESC_STRUCTURE=0.05
# TUBEFORGE_SEO_TAGS_RELEVANCE=0.10
# TUBEFORGE_SEO_TAGS_QUALITY=0.05
# TUBEFORGE_SEO_KEYWORD_TAGS=0.05
# TUBEFORGE_GEO_ENTITY_COVERAGE=0.24
# TUBEFORGE_GEO_QA_PHRASING=0.12
# TUBEFORGE_GEO_LIST_PHRASING=0.12
# TUBEFORGE_GEO_CONVERSATIONAL=0.16
# TUBEFORGE_GEO_METADATA_COMPLETE=0.16
# TUBEFORGE_GEO_LOCATION_SIGNAL=0.10
# TUBEFORGE_GEO_TOPIC_RELEVANCE=0.10

# Days after which a channel counts as stale (health/alerts rules).
TUBEFORGE_STALE_DAYS=14

# Quota warn threshold (percent) for the YouTube Data API.
TUBEFORGE_QUOTA_WARN_AT=90

# tracing filter level: trace|debug|info|warn|error
LOG_LEVEL=info

# Port for `tubeforge serve` (HTMX dashboard; default 8080). Loopback only —
# single-user, no auth; the CSRF origin guard is the only cross-origin
# protection. Do not run writing commands while the server is up (single
# writer, LLD §10).
TUBEFORGE_SERVE_PORT=8080

# OPT-IN third-party lookup (`tubeforge filmot get`): your own Filmot API
# key. Empty = Filmot commands refuse (TubeForge never embeds Filmot's key).
TUBEFORGE_FILMOT_KEY=
